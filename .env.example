# Algo Trader Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to git - it contains secrets!

# ── Alpaca Broker ──────────────────────────────────────────
# Get from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=YOUR_API_KEY_HERE
ALPACA_SECRET_KEY=YOUR_SECRET_KEY_HERE

# Paper Trading: https://paper-api.alpaca.markets
# Live Trading: https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Database ───────────────────────────────────────────────
# Local: postgresql://postgres:PASSWORD@localhost:5432/algotrader
# Cloud: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://postgres:Reena2220@localhost:5432/algotrader

# ── Trading Configuration ──────────────────────────────────
# Symbols to trade
TRADING_SYMBOLS=SPY,QQQ,AAPL

# Maximum position size as % of portfolio
MAX_POSITION_SIZE=0.10

# Maximum daily loss before trading halt (as %)
MAX_DAILY_LOSS=0.03

# Stop loss percentage per trade
STOP_LOSS_PCT=0.02

# Take profit percentage per trade
TAKE_PROFIT_PCT=0.04

# Maximum number of open positions
MAX_OPEN_POSITIONS=5

# ── Flask Configuration ────────────────────────────────────
# Secret key for session management (generate random string)
FLASK_SECRET_KEY=mysecretkey123

# Port for Flask dashboard
DASHBOARD_PORT=5000

# ── Environment ───────────────────────────────────────────
# paper = Paper trading (safe to test)
# live = Live trading (real money - CAREFUL!)
ENV=paper

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Optional: AWS/Cloud Configuration ──────────────────────
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# ── Optional: Email Notifications ──────────────────────────
# SENDGRID_API_KEY=your_sendgrid_key
# ALERT_EMAIL=your@email.com
